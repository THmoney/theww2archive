body {
    font-family: Arial, sans-serif;
    line-height: 1.6;
    color: #333;
    max-width: 800px;
    margin: 0 auto;
    padding: 20px;
    background-color: #f9f9f9;
}
header {
    background: #2c3e50;
    color: #fff;
    padding: 20px;
    text-align: center;
    border-radius: 5px;
}
header nav a {
    color: #ecf0f1;
    text-decoration: none;
    margin: 0 10px;
}
main {
    background: #fff;
    padding: 30px;
    margin-top: 20px;
    border-radius: 5px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}
.meta {
    color: #7f8c8d;
    font-size: 0.9rem;
    margin-bottom: 20px;
}
footer {
    text-align: center;
    margin-top: 30px;
    color: #7f8c8d;
    font-size: 0.85rem;
}

